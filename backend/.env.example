# Avigilon NVR connection
NVR_IP=192.168.1.100
NVR_PORT=554
ONVIF_PORT=80
NVR_USERNAME=admin
NVR_PASSWORD=changeme

# Camera channel routed through the NVR (0-indexed profile/channel on the NVR)
CAMERA_CHANNEL_ID=0

# Dashboard login (gates the web UI itself, separate from NVR credentials)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
SESSION_SECRET_KEY=replace-with-a-long-random-string
